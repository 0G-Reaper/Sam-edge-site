# Copy to .env for local development. Never commit real values.
PORT=8080
DB_PATH=./data/waitlist.sqlite
# Bearer token for the CSV export at /api/admin/export.csv (leave unset to disable the export entirely)
ADMIN_TOKEN=
# Social links shown in the footer. Leave empty to show "opening soon".
SITE_INSTAGRAM_URL=
SITE_DISCORD_URL=
# Public hostname. Set it in production so the www form and the platform domain 301 to https://<this>.
CANONICAL_HOST=
# mailto: or https: URI published at /.well-known/security.txt. Optional.
SECURITY_CONTACT=
